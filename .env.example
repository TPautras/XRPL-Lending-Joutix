# ── Wallet credentials for the UI ────────────────────────────────────────────
# Crossmark and GemWallet need no credential and are always offered.

# REQUIRED for the XRPL Dev Wallet extension
# (github.com/oz-ross/xrpl-dev-wallet-extension). That extension registers no content
# script and injects no page global, so it cannot be auto-detected — it is reachable
# ONLY over WalletConnect, by pasting the dApp's `wc:` URI into its popup. Without this
# id the WalletConnect adapter is not constructed and the wallet is absent from the
# connect modal. Free id from https://cloud.walletconnect.com (now Reown); the same id
# also goes in the extension's own .env as WC_PROJECT_ID.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: adds Xaman to the connect modal.
VITE_XAMAN_API_KEY=

# ── Custom Hackathon Devnet (Track 1) — src/protocol/ scripts ────────────────
HACKATHON_RPC=https://s.devnet.rippletest.net:51234/
HACKATHON_WSS=wss://s.devnet.rippletest.net:51233/
HACKATHON_FAUCET_HOST=faucet.devnet.rippletest.net
HACKATHON_EXPLORER=https://devnet.xrpl.org

# ── Devnet account seeds for the protocol scripts (src/protocol/) ────────────
# Never commit real seeds. Leave blank and `npm run probe` will fund fresh ones
# from the faucet and print them here for you to paste back in.
AUTHORITY_SEED=
ISSUER_SEED=
MANAGER_SEED=
SME_SEED=
SME_UNCREDENTIALED_SEED=
INVESTOR_A_SEED=
INVESTOR_B_SEED=
INSURER_SEED=
