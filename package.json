{
  "name": "xrpl-tokenized-credit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.protocol.json",
    "probe": "tsx src/protocol/probe.ts",
    "demo": "tsx src/protocol/demo.ts",
    "smoke": "vite build --config scripts/smoke.vite.config.ts && node scripts/smoke.mjs",
    "smoke:live": "vite build --config scripts/smoke.vite.config.ts && LIVE=1 ROUTES=/dashboard node scripts/smoke.mjs",
    "visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xrpl": "5.2.0",
    "xrpl-connect": "0.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^17.0.0",
    "five-bells-condition": "5.0.1",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
